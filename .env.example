# =========================================
# Ambiente
# =========================================
NODE_ENV=development
PORT=3333

# =========================================
# Banco de dados (PostgreSQL)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
# =========================================
DATABASE_URL="postgresql://postgres:finedubanco@localhost:5432/finedu?schema=public"

# =========================================
# Autenticacao JWT
# Gere um valor aleatorio e seguro, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =========================================
JWT_SECRET="bdebe189257c2e1f4c16ae8216217327c08b39950404dc03fd4145f41e7d3eba1530f42685ec4c9c25b3dbfbda1d070c"
JWT_EXPIRES_IN="1d"

# =========================================
# Seguranca
# =========================================
BCRYPT_SALT_ROUNDS=12

# =========================================
# CORS - origem(ns) permitida(s) do frontend, separadas por virgula
# =========================================
CORS_ORIGIN="http://localhost:5173"
